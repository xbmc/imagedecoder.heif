msgctxt "Addon Summary"
msgid "HEIF file format decoder"
msgstr "Díchódóir formáid comhaid HEIF"

msgctxt "Addon Description"
msgid "High Efficiency Image File Format (HEIF) is a file format employing HEVC (h.265) image coding for the best compression ratios currently possible.[CR][CR]Support for this is provided by ISO/IEC 23008-12:2017 compliant libheif."
msgstr "Is formáid comhaid í Formáid Comhad Íomhá Ard-Éifeachtúlachta (HEIF) a úsáideann códú íomhá HEVC (h.265) chun na cóimheasa comhbhrúite is fearr is féidir a fháil faoi láthair.[CR][CR]Tacaíonn libheif, atá comhlíontach le ISO/IEC 23008-12:2017, leis seo."

#. Supported file extension ".heif" and mimetype "image/heif" description
#: imagedecoder.raw/addon.xml.in
msgctxt "#30100"
msgid "An HEIF file is an image saved in the High Efficiency Image Format (HEIF), a lossy compressed format."
msgstr "Is íomhá í comhad HEIF atá sábháilte i bhFormáid Íomhá Ard-Éifeachtúlachta (HEIF), formáid chomhbhrúite caillteanach."

#. Supported file extension ".heic" and mimetype "image/heic" description
#: imagedecoder.raw/addon.xml.in
msgctxt "#30101"
msgid "An HEIC file contains one or more images saved in the High Efficiency Image Format (HEIF)."
msgstr "Tá íomhá amháin nó níos mó i gcomhad HEIC atá sábháilte i bhFormáid Íomhá Ard-Éifeachtúlachta (HEIF)."
